# Variables del sitio de Grupo Nitamy.
#
# Ninguna es obligatoria: el sitio arranca y compila sin este archivo. Están
# aquí para documentar qué se puede mover desde Vercel sin tocar código.
#
# Copia este archivo a `.env.local` para trabajar en tu máquina. `.env.local`
# está en el .gitignore y nunca se sube.

# Dominio público del sitio. Alimenta el canonical, el sitemap, el Open Graph
# y los datos estructurados. Sin barra final.
# Por defecto: https://www.gruponitamy.com
NEXT_PUBLIC_SITE_URL=https://www.gruponitamy.com

# ¿Dejamos que Google indexe?
#
# Por defecto NO. Mientras el cliente no confirme el segundo WhatsApp (viene
# con 12 dígitos en el brief y en el PDF) y no apruebe los textos en borrador,
# el sitio se sirve con `noindex` y con robots.txt cerrado.
#
# Ponlo en `true` SOLO cuando el contenido esté aprobado, y vuelve a desplegar:
# esta variable se hornea en el build, no se lee en caliente.
NEXT_PUBLIC_PERMITIR_INDEXACION=false

# A dónde se van los formularios de cotización.
# `consola` (por defecto) solo los imprime en el log del servidor: sirve para
# desarrollo, pero en producción significa que NADIE recibe los leads.
LEAD_ADAPTER=consola
